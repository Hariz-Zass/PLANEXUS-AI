# Optional: enable LLM answers; never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Use a persistent local directory for development (NOT ephemeral serverless storage).
PLANEXUS_DATA_DIR=./data
PLANEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For a container deployed with durable named volume at /data:
# PLANEXUS_DATA_DIR=/data
# PLANEXUS_REQUIRE_PERSISTENT_VOLUME=1
# No volume: health and all writes return 503. Never expose this API publicly.

# B3.2: Security controls. The first admin is created OFFLINE using:
# python -m app.auth create-admin --email YOUR_EMAIL --name YOUR_NAME
# Local Windows launcher prompts automatically on first run.
# Session cookie is Secure for non-local hosts by default.
# PLANEXUS_COOKIE_SECURE=1
# Production frontend/backend must share a cookie site (same eTLD+1)
# or use a protected reverse proxy. HTTP localhost supports host-only cookies.
# No open registration: every planner account requires a one-use CLI invite.

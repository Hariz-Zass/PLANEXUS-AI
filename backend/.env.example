# Optional: enable LLM answers; never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Use a persistent local directory for development (NOT ephemeral serverless storage).
PLANEXUS_DATA_DIR=./data
PLANEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For a container deployed with durable named volume at /data:
# PLANEXUS_DATA_DIR=/data
# PLANEXUS_REQUIRE_PERSISTENT_VOLUME=1
# No volume: health and all writes return 503. Never expose this API publicly.

# B3.2: Security controls. The first admin is created OFFLINE using:
# python -m app.auth create-admin --email YOUR_EMAIL --name YOUR_NAME
# Local Windows launcher prompts automatically on first run.
# Session cookie is Secure for non-local hosts by default.
# PLANEXUS_COOKIE_SECURE=1
# Production frontend/backend must share a cookie site (same eTLD+1)
# or use a protected reverse proxy. HTTP localhost supports host-only cookies.
# No open registration: every planner account requires a one-use CLI invite.


# Data around the site (optional hosted source, no manual searching per parcel).
# A registered Overpass.ch provider key is a one-time backend setup;
# DO NOT place it in NEXT_PUBLIC_ variables or Git. Without it, limited
# public best-effort servers can time out or block busy shared runners.
# PLANEXUS_OVERPASS_CH_API_KEY=
# Source © OpenStreetMap contributors under ODbL. This is never official PBT zoning.

# Optional PRIVATE PostGIS-first OSM nearby discovery. Enable only when the
# operator has a persistent server/DB and imported a genuine Geofabrik extract.
# Use compose.gis.yml + compose.osm.yml (see docs/OSM_POSTGIS_OPERATOR_GUIDE.md).
# Never set this in NEXT_PUBLIC_ variables or commit a real connection password.
# PLANEXUS_OSM_POSTGIS_DSN=postgresql://user:URL_SAFE_PASSWORD@osm-db:5432/planexus_osm
#
# Optional offline GeoPackage backup if PostGIS and Overpass are unavailable.
# PLANEXUS_OSM_GEOFABRIK_GPKG=/data/osm
# PLANEXUS_OSM_EXTRACT_DATE=2026-11-02T00:00:00Z
#
# When PostGIS isn't configured, existing public Overpass retrieval remains
# best-effort and may time out. OSM never substitutes official RT/zoning.
